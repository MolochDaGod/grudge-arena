{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/grudge/game/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/:path*"
    },
    {
      "source": "/api/grudge/id/:path*",
      "destination": "https://id.grudge-studio.com/:path*"
    },
    {
      "source": "/api/grudge/account/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/account/:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://id.grudge-studio.com/auth/:path*"
    },
    {
      "source": "/api/login",
      "destination": "https://id.grudge-studio.com/auth/login"
    },
    {
      "source": "/api/register",
      "destination": "https://id.grudge-studio.com/auth/register"
    },
    {
      "source": "/api/guest",
      "destination": "https://id.grudge-studio.com/auth/guest"
    },
    {
      "source": "/api/oauth-google",
      "destination": "https://id.grudge-studio.com/auth/google?redirect_uri=https://grudge-arena.grudge-studio.com"
    },
    {
      "source": "/api/oauth-discord",
      "destination": "https://id.grudge-studio.com/auth/discord?redirect_uri=https://grudge-arena.grudge-studio.com"
    },
    {
      "source": "/api/oauth-github",
      "destination": "https://id.grudge-studio.com/auth/github?redirect_uri=https://grudge-arena.grudge-studio.com"
    },
    {
      "source": "/api/wallet",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/wallet"
    },
    {
      "source": "/api/wallet/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/wallet/:path*"
    },
    {
      "source": "/api/account/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/account/:path*"
    },
    {
      "source": "/api/characters/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/characters/:path*"
    },
    {
      "source": "/api/characters",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/characters"
    },
    {
      "source": "/api/nfts/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/nfts/:path*"
    },
    {
      "source": "/api/game/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/:path*"
    },
    {
      "source": "/api/assets/:path*",
      "destination": "https://assets.grudge-studio.com/:path*"
    },
    {
      "source": "/cdn/:path*",
      "destination": "https://assets.grudge-studio.com/arena/:path*"
    },
    { "source": "/((?!api/|cdn/|assets/|models/|favicon|grudge-logo|robots\\.txt|manifest|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://id.grudge-studio.com https://*.grudge-studio.com" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/assets/animations/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/assets/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
