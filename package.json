{
  "name": "grudge-arena",
  "version": "1.0.0",
  "description": "Grudge Arena — 3D PvP Combat Arena with 6 playable races",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --no-cache",
    "test:watch": "vitest",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "deploy:prod": "node scripts/deploy.mjs --prod",
    "deploy:sandbox": "node scripts/deploy-sandbox.mjs",
    "deploy:full": "node scripts/deploy.mjs --prod --assets",
    "sync:assets": "node scripts/sync-assets-r2.mjs",
    "sync:assets:dry": "node scripts/sync-assets-r2.mjs --dry-run",
    "smoke:arena": "node scripts/smoke-arena.mjs",
    "smoke:arena:3v3": "node scripts/smoke-arena-3v3.mjs",
    "smoke:sandbox": "node scripts/smoke-sandbox-arena.mjs",
    "smoke:sandbox:local": "node scripts/smoke-sandbox-arena.mjs --local",
    "smoke:anim-test": "node scripts/smoke-anim-test.mjs",
    "smoke:anim-test:all": "node scripts/smoke-anim-test-all-races.mjs",
    "smoke": "node scripts/smoke-arena.mjs && node scripts/smoke-arena-3v3.mjs && node scripts/smoke-anim-test.mjs",
    "convert:island-village": "node scripts/convert-island-village.mjs",
    "ingest:pirate-kit": "node scripts/ingest-pirate-kit.mjs",
    "bake:anim-bank": "node scripts/bake-anim-bank.mjs locomotion uploads uploads_2026_06 sword_shield magic longbow unarmed pistol rifle",
    "ingest:boxanims": "node scripts/ingest-boxanimations.mjs",
    "bake:boxanims": "node scripts/bake-mixamo-staging.mjs",
    "pipeline:boxanims": "node scripts/ingest-boxanimations.mjs && node scripts/bake-mixamo-staging.mjs && node scripts/build-anim-catalog.mjs",
    "sync:atlases": "node scripts/sync-race-atlases.mjs",
    "ingest:30grudge6": "node scripts/process-30grudge6-characters.mjs",
    "ingest:30grudge6:upload": "node scripts/process-30grudge6-characters.mjs --upload-only",
    "import:forge": "node scripts/import-forge-prefabs.mjs",
    "bake:characters": "node scripts/build-character-library.mjs",
    "bake:forge": "node scripts/build-character-library.mjs && node scripts/import-forge-prefabs.mjs",
    "optimize:sandbox": "node scripts/optimize-sandbox-assets.mjs",
    "bake:prefabs": "node scripts/build-character-library.mjs && node scripts/build-anim-catalog.mjs",
    "validate:assets": "node scripts/validate-arena-assets.mjs",
    "validate:gltf": "node scripts/validate-gltf-contract.mjs",
    "pipeline:sandbox": "node scripts/pipeline-sandbox.mjs",
    "build:anim-catalog": "node scripts/build-anim-catalog.mjs"
  },
  "devDependencies": {
    "fbx2gltf": "^0.9.7-p1",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.2",
    "cannon-es": "^0.20.0",
    "socket.io-client": "^4.7.0",
    "three": "^0.160.0",
    "xstate": "^5.30.0"
  }
}
